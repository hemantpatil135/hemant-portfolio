# Public site URL — used for SEO metadata, Open Graph, sitemap and JSON-LD.
# MUST be the origin you actually own. Point it at someone else's domain and
# canonical/sitemap hand your ranking signals to them. If unset, the app falls
# back to Vercel's injected deployment host (see src/lib/theme.ts), never to a
# hardcoded third party. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://hemantpatil.vercel.app

# ── Contact form email delivery ───────────────────────────────────────
# The form POSTs to /api/contact, which emails you the message.
# Set ONE of the two keys below and it just works. Until then, the form
# shows a "reach me directly" message (email + WhatsApp) — no mail popup.

# Option A (EASIEST — no account/password). The Web3Forms key is submitted
# from the browser (their free plan is client-side only) and is public by
# design, so it uses the NEXT_PUBLIC_ prefix.
#   1. Go to https://web3forms.com
#   2. Enter your inbox email (patilhemantsing@gmail.com) → you get an
#      "Access Key" emailed to you instantly.
#   3. Paste it below (and in .env.local for local dev, and in your host's
#      env vars for production, e.g. Vercel). Restart the dev server.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Option B (alternative — free Resend account at https://resend.com,
# sign up with your inbox email so the default sender can deliver to you):
RESEND_API_KEY=
# Optional verified sender once you add your own domain in Resend:
CONTACT_FROM=

# ── SEO ───────────────────────────────────────────────────────────────
# Google Search Console verification token (Settings → Ownership
# verification → HTML tag; paste only the content="..." value).
# Needed to submit the sitemap and see which queries surface the site.
GOOGLE_SITE_VERIFICATION=
